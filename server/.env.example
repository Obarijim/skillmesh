# Copy this file to .env and fill in real values. Never commit the real .env.

APP_NAME=SkillMesh API
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of origins allowed to call this API (the client's dev URL by default)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection string: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://skillmesh:skillmesh@localhost:5432/skillmesh

# Used later for auth (sessions/JWT) — generate a real random value before using in production
SECRET_KEY=change-me-in-env

# Pre-trained sentence-embedding model used by the semantic matching module (added later)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
